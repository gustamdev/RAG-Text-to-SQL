# Copie para .env (ou .env.local, que tem prioridade). Nenhum valor aqui é segredo.

# local | prod  (prod desliga /docs, /redoc, /openapi.json e o reload)
ENV=local
HOST=0.0.0.0
PORT=8000
# Origens extras para CORS, separadas por vírgula
CORS_EXTRA_ORIGINS=

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=olist
# true: o backend sobe o container via docker compose no startup (só para desenvolvimento local)
MONGO_AUTOSTART=true

# Contas de administrador ficam neste mesmo banco (coleção users). Não há auto-cadastro:
# crie a primeira com `uv run python scripts/create_admin.py email@exemplo.com "Nome"`.
# Segredo do JWT. Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obrigatório com ENV=prod; vazio em dev gera um segredo efêmero a cada start.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Tentativas de login com falha por e-mail+IP dentro da janela (s) antes do bloqueio temporário
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_S=900

# Repositório de onde o seed baixa os CSVs do Olist
OLIST_BASE_URL=https://raw.githubusercontent.com/gustamdev/Olist-E-Commerce-Public-Dataset-2017-2018/main
# Ano dos pedidos que o seed carrega no Mongo (padrão 2018). Vazio = todos os anos.
# Só vale para um banco ainda vazio: o seed não roda sobre dados existentes.
SEED_YEAR=2018

# Motor SQL (DuckDB): snapshot somente leitura gerado a partir do Mongo.
# Vazio = data/olist.duckdb. Apague o arquivo para forçar a recriação no próximo start.
DUCKDB_PATH=
SQL_QUERY_TIMEOUT_S=15
SQL_MAX_CONCURRENT=4
# Por quanto tempo (s) e quantos resultados de consulta ficam guardados para o GET
QUERY_RESULT_TTL_S=900
QUERY_RESULT_MAX=200

# LLM (OpenAI): segredo e limites de infraestrutura. Perfis de modelo (nome, temperatura)
# ficam em src/app/llm_models.py, não aqui.
OPENAI_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Histórico de execuções do agente (services/agent_runner.py), para o GET de eventos.
CHAT_RESULT_TTL_S=900
CHAT_RESULT_MAX=200
# Limite de perguntas ao chat por administrador: CHAT_RATE_LIMIT perguntas a cada
# CHAT_RATE_WINDOW_S segundos (janela deslizante em memória, por processo). Acima disso, 429.
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_S=600

# Observabilidade (LangSmith): tracing de todo Runnable LangChain/LangGraph, mais os pontos
# marcados com @traceable (validação de SQL, execução no DuckDB, geração do catálogo).
# Desligado por padrão. Para ligar: crie uma conta grátis em https://smith.langchain.com,
# gere uma API key em Settings > API Keys, e preencha as duas primeiras linhas abaixo.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-backend
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Memória de sessão do agente (services/memory.py): histórico recente + resumo consolidado
# por session_id, para dar continuidade entre perguntas. Não sobrevive a restart do processo.
MEMORY_TURNS_PER_CONSOLIDATION=10
MEMORY_CONTEXT_MAX_TOKENS=1500
MEMORY_SESSION_TTL_S=3600
MEMORY_SESSION_MAX=500
